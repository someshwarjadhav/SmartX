# Copy this file to .env.local (same folder as package.json), fill the values, then restart `npm run dev`.
# Never commit .env.local or put account passwords/tokens in source control.

# REQUIRED for sign-in: login sends the username/password AES-encrypted, so without this key
# the login page shows "Sign-in is not configured correctly". Use the exact key the MilkShell portal uses.
VITE_ENCRYPTION_KEY=

# NOTE: `npm run dev` already uses the Vite proxy from .env.development (/api and /stipl),
# so only set the two URLs below in .env.local if you want to bypass the proxy.
# MilkShell API/gateway base URL, no trailing slash.
# VITE_API_BASE_URL=https://smartx.shivinfotech.co.in

# Optional: change only if the portal uses a different login route.
VITE_LOGIN_PATH=/home/userlogin

# Optional: some transaction/settings services use this separate STIPL host.
# VITE_STIPL_BASE_URL=https://stipldrive.ddns.net

# Optional: comma-separated centre/VLCC IDs if login does not return them.
VITE_VLCC_IDS=
# Optional fallback IDs if they are not returned by login.
VITE_MCC_ID=
VITE_STATION_ID=

# Optional: DPU API base (menu binding getmenu + FarmerCollection), no trailing slash.
# VITE_DPU_BASE_URL=https://dpu.shivinfotech.co.in/api

# Optional: public portal URL used by links in settings.
VITE_PORTAL_URL=https://smartx.shivinfotech.co.in/prodigy/#

# Optional API formatting overrides.
VITE_API_DATE_FORMAT=yyyy-MM-dd
VITE_FARMER_MILK_CODES=C,B,M

# Development only: pre-fills the sign-in form in `npm run dev` (ignored in production builds).
# VITE_DEV_EMAIL=
# VITE_DEV_PASSWORD=
